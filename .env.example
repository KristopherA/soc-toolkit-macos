# Local Mac settings. ./setup.sh creates .env and generates unique secrets.
# Ports avoid the Admin Toolkit (3001, 8000-8001, 8080-8092, 8443) so both run side by side.
DASHBOARD_PORT=9080
# HTTPS name served by Caddy (~/docker/caddy); needs a 127.0.0.1 line in /etc/hosts
SOC_HOSTNAME=soc.tools.kristopher.cloud
# Tool links use https://<tool>.$SOC_DOMAIN when set; empty = localhost ports
SOC_DOMAIN=tools.kristopher.cloud
BLOODHOUND_ROOT_URL=https://bloodhound.tools.kristopher.cloud
CADDY_DIR=~/docker/caddy
BLOODHOUND_PORT=9081
MOBSF_PORT=9082
NETTACKER_PORT=9083
CLICKGRAB_PORT=9084

# Where ./sync-sources.sh copies the source-built tools from
GITHUB_PROJECTS_DIR=~/Documents/GitHubProjects
# Ghidra release folder; built in place (about 800 MB, so it is not copied into src/)
GHIDRA_DIR=/Users/kristopher/Documents/GitHubProjects/Malware-Analysis-RE/ghidra_12.0_PUBLIC
GHIDRA_MAXMEM=4G

# BloodHound CE: sign in as admin with BLOODHOUND_ADMIN_PASSWORD; it must be changed at first login
BLOODHOUND_TAG=latest
BLOODHOUND_ADMIN_PASSWORD=CHANGE_ME_BLOODHOUND_ADMIN
BLOODHOUND_DB_PASSWORD=CHANGE_ME_BLOODHOUND_DB
BLOODHOUND_NEO4J_PASSWORD=CHANGE_ME_BLOODHOUND_NEO4J
BLOODHOUND_NEO4J_HEAP=2G

MOBSF_TAG=latest
# MobSF sign-in: user mobsf with this password
MOBSF_ADMIN_PASSWORD=CHANGE_ME_MOBSF_ADMIN
# Paste this into Nettacker's web UI key box
NETTACKER_API_KEY=CHANGE_ME_NETTACKER_KEY

# Email Check (Reacher). HELLO_NAME/FROM_EMAIL are what remote mail servers see in the SMTP probe.
REACHER_TAG=latest
REACHER_SECRET=CHANGE_ME_REACHER_SECRET
REACHER_HELLO_NAME=localhost
REACHER_FROM_EMAIL=postmaster@localhost

# Resolvers for Email Check, Amass and tlsx (external view, not UNA internal DNS)
PUBLIC_DNS_1=1.1.1.1
PUBLIC_DNS_2=9.9.9.9

# Optional API keys; leave empty if unused
VTCLI_APIKEY=
OTX_API_KEY=

# CLI image tags
AMASS_TAG=latest
TLSX_TAG=latest
GRYPE_TAG=latest
SYFT_TAG=latest
MAIGRET_TAG=latest

# Detections repo (Sigma rules, pySigma pipelines, Snort rules). Mounted at /detections for
# ./soc sigma, ./soc detections and ./soc snort-replay. Absolute path; spaces are fine, no quotes.
DETECTIONS_DIR=./cases/detections
